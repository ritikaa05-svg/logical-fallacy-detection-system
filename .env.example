# Example .env (DO NOT COMMIT SECRETS)
# Copy this to .env and fill values locally.

# Model paths
STAGE1_MODEL_PATH=./models/stage1_v13_classifier
STAGE2_MODEL_PATH=./models/stage3_v13_classifier
STAGE3_MODEL_PATH=./models/stage3_v13_classifier

# Hugging Face API (optional)
HUGGINGFACE_API_TOKEN=hf_<REPLACE_WITH_YOUR_TOKEN>
HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models
HF_MODEL_ID=owner/repo-model
DISABLE_API_FALLBACK=false

# Caching
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=86400

# Database
DATABASE_URL=postgresql+asyncpg://logiscan:changeme@localhost:5432/logiscan

# Runtime
SALIENCE_THRESHOLD=0.6
MAX_INPUT_TOKENS=2000
